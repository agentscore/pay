{
  "name": "@agent-score/pay",
  "version": "0.2.3",
  "description": "CLI wallet for one-shell-command agent payments across x402 (Base) and MPP (Tempo, Solana)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentscore-pay": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:binary:darwin-arm64": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/bin/agentscore-pay-darwin-arm64",
    "build:binary:darwin-x64": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/bin/agentscore-pay-darwin-x64",
    "build:binary:linux-arm64": "bun build src/index.ts --compile --target=bun-linux-arm64 --outfile dist/bin/agentscore-pay-linux-arm64",
    "build:binary:linux-x64": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/bin/agentscore-pay-linux-x64",
    "build:binary:windows-x64": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile dist/bin/agentscore-pay-windows-x64.exe",
    "build:binary:all": "bun run build:binary:darwin-arm64 && bun run build:binary:darwin-x64 && bun run build:binary:linux-arm64 && bun run build:binary:linux-x64 && bun run build:binary:windows-x64",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "agentscore",
    "x402",
    "mpp",
    "tempo",
    "cli",
    "wallet",
    "base",
    "solana",
    "usdc",
    "ai-agent",
    "agentic-payments",
    "eip-3009",
    "spl-token"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentscore/pay"
  },
  "homepage": "https://agentscore.sh",
  "bugs": {
    "url": "https://github.com/agentscore/pay/issues"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@agent-score/sdk": "^2.3.2",
    "@clack/prompts": "^1.4.0",
    "@scure/bip39": "^2.2.0",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.13.0",
    "@solana/kit": "^6.9.0",
    "@solana/mpp": "^0.5.2",
    "@x402/core": "^2.12.0",
    "@x402/evm": "^2.12.0",
    "@x402/fetch": "^2.12.0",
    "ed25519-hd-key": "^2.0.0",
    "incur": "0.4.6",
    "mppx": "^0.6.20",
    "qrcode-terminal": "^0.12.0",
    "viem": "2.49.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.8.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "lefthook": "^2.1.6",
    "tsup": "^8.5.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "minimatch@^3.0.0": {
      "brace-expansion": "1.1.12"
    },
    "minimatch@^10.0.0": {
      "brace-expansion": "5.0.6"
    }
  },
  "packageManager": "bun@1.3.13"
}
