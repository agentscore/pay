{
  "name": "@agent-score/pay",
  "version": "0.5.3",
  "description": "CLI wallet for one-shell-command agent payments across x402 (Base) and MPP (Tempo, Solana)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentscore-pay": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:binary:darwin-arm64": "node scripts/build-binary.mjs bun-darwin-arm64 dist/bin/agentscore-pay-darwin-arm64",
    "build:binary:darwin-x64": "node scripts/build-binary.mjs bun-darwin-x64 dist/bin/agentscore-pay-darwin-x64",
    "build:binary:linux-arm64": "node scripts/build-binary.mjs bun-linux-arm64 dist/bin/agentscore-pay-linux-arm64",
    "build:binary:linux-x64": "node scripts/build-binary.mjs bun-linux-x64 dist/bin/agentscore-pay-linux-x64",
    "build:binary:windows-x64": "node scripts/build-binary.mjs bun-windows-x64 dist/bin/agentscore-pay-windows-x64.exe",
    "build:binary:all": "bun run build:binary:darwin-arm64 && bun run build:binary:darwin-x64 && bun run build:binary:linux-arm64 && bun run build:binary:linux-x64 && bun run build:binary:windows-x64",
    "dev": "tsx src/index.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build",
    "knip": "knip"
  },
  "keywords": [
    "agentscore",
    "x402",
    "mpp",
    "tempo",
    "cli",
    "wallet",
    "base",
    "solana",
    "usdc",
    "ai-agent",
    "agentic-payments",
    "eip-3009",
    "spl-token"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentscore/pay"
  },
  "homepage": "https://www.agentscore.com",
  "bugs": {
    "url": "https://github.com/agentscore/pay/issues"
  },
  "engines": {
    "node": ">=22 <25",
    "bun": ">=1.3.0 <2"
  },
  "dependencies": {
    "@agent-score/sdk": "^2.7.9",
    "@clack/prompts": "^1.7.0",
    "@scure/bip39": "^2.4.0",
    "@solana-program/system": "^0.14.1",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.2.0",
    "@solana/mpp": "^0.7.0",
    "@x402/core": "2.24.0",
    "@x402/evm": "2.24.0",
    "@x402/fetch": "2.24.0",
    "ed25519-hd-key": "^2.0.0",
    "incur": "0.5.1",
    "mppx": "0.9.2",
    "qrcode-terminal": "^0.12.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.17",
    "viem": "2.56.3"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "incur@0.5.1": "patches/incur@0.5.1.patch"
  }
}
